# Backend env vars for the Vexa bot integration.
# Vexa is a separate service stack — use the hosted cloud or self-host
# via Docker Compose / Helm.
#
# Source these into your existing backend env (or merge into backend/.env).

# ────────────────────────────────────────────────────────────────
# Cloud (recommended for first test) — https://vexa.ai/account
# ────────────────────────────────────────────────────────────────
VEXA_BASE_URL=https://api.cloud.vexa.ai

# Self-hosted alternative:
#   VEXA_BASE_URL=http://localhost:18056            # local docker-compose
#   VEXA_BASE_URL=http://vexa-meeting-api:18056     # Coolify / in-cluster

# Vexa User API key. Get one at https://vexa.ai/account (free beta).
# Sent as `X-API-Key` header on every request.
VEXA_API_KEY=replace-with-your-vexa-api-key

# Display name for the bot in the meeting roster.
POCKETPAW_BOT_DISPLAY_NAME=PocketPaw Bot
