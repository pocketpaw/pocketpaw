# Copy to .env (gitignored) and fill in. Read by the postiz container only.
# After changing anything: docker compose down && docker compose up -d

# Signs Postiz sessions and connect links. Generate with: openssl rand -hex 32
JWT_SECRET=

# Max create-post calls per hour on the public API (Postiz Cloud uses ~100).
API_LIMIT=1000

# X (Twitter): developer.x.com -> your app -> User authentication settings:
#   App permissions: Read and write   |   Type of App: Native App
#   Callback URI: http://127.0.0.1:4007/integrations/social/x (X rejects "localhost")
#   Website URL: any public https URL
# Then Keys and tokens -> Consumer Keys -> API Key and Secret.
X_API_KEY=
X_API_SECRET=

# LinkedIn (linkedin + linkedin-page): linkedin.com/developers/apps
#   Products: Share on LinkedIn, Sign In with LinkedIn using OpenID Connect,
#   Advertising API (review form; without it connects fail with NotEnoughScopes)
#   Redirect URLs: http://127.0.0.1:4007/integrations/social/linkedin
#                  http://127.0.0.1:4007/integrations/social/linkedin-page
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Pinterest: developers.pinterest.com/apps (business account, app approval)
#   Redirect URI: http://127.0.0.1:4007/integrations/social/pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# Dribbble: dribbble.com/account/applications/new
#   Callback URL: http://127.0.0.1:4007/integrations/social/dribbble
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=

# Slack: api.slack.com/apps -> From scratch. Set a square app icon (512px+).
#   OAuth & Permissions -> Redirect URL (Postiz adds the redirectmeto hop on http):
#     https://redirectmeto.com/http://127.0.0.1:4007/integrations/social/slack
#   Bot Token Scopes: chat:write, chat:write.customize, channels:read,
#     channels:join, groups:read, users:read
SLACK_ID=
SLACK_SECRET=
SLACK_SIGNING_SECRET=

# Telegram: @BotFather -> /newbot. Same token goes to the PocketPaw backend as
# POCKETPAW_POSTIZ_TELEGRAM_BOT_TOKEN / _BOT_NAME.
TELEGRAM_TOKEN=
TELEGRAM_BOT_NAME=
