      { "label": "Location", "value": "Lagos, NG", "icon": "map-pin" }
    ],
    "profile": [
      { "key": "Email", "value": "amara@example.com" },
      { "key": "Phone", "value": "+1 555 0142" },
      { "key": "Member since", "value": "March 2023" },
      { "key": "Location", "value": "Lagos, NG" }
    ],
    "membership": [
