# Backend env vars for the Recall.ai meeting-bot integration.
#
# Recall.ai (https://recall.ai) is a hosted service that sends a bot into
# Zoom / Google Meet / Teams calls to record and transcribe them. There
# is nothing to self-host — sign up, create an API key, paste it here.
#
# Source these into your existing backend env (or merge into backend/.env).

# ────────────────────────────────────────────────────────────────
# Region — Recall.ai runs four data-isolated regions. Your API key is
# tied to ONE region; set this to match where you created the key.
#   us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1
# ────────────────────────────────────────────────────────────────
RECALL_REGION=us-east-1

# Optional: override the base URL outright (proxies / tests). When set,
# RECALL_REGION is ignored.
# RECALL_BASE_URL=https://us-east-1.recall.ai

# Operator API key from the Recall.ai dashboard (region-specific).
# Sent as `Authorization: Token <key>` on every request.
RECALL_API_KEY=replace-with-your-recall-api-key

# Svix signing secret for the inbound webhook. Create a webhook in the
# Recall dashboard pointing at:
#   https://{your-host}/api/v1/meetings/webhooks/recall
# then copy its signing secret here. Starts with `whsec_`.
# If unset, the webhook is accepted WITHOUT signature verification —
# acceptable only for local dev.
RECALL_WEBHOOK_SECRET=replace-with-your-recall-webhook-secret

# Async transcription provider configured on each bot. Defaults to
# Recall's own engine. To use a BYO STT vendor (already linked in the
# Recall dashboard), set e.g. deepgram_async / assembly_ai_async.
# RECALL_TRANSCRIPT_PROVIDER=recallai_async

# Display name for the bot in the meeting roster.
POCKETPAW_BOT_DISPLAY_NAME=PocketPaw Bot
