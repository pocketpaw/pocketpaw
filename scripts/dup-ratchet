def _match(rel: str, globs: tuple[str, ...]) -> bool:
    return any(fnmatch(rel, g) for g in globs)


def count(root: Path, regex: str, include: tuple[str, ...], exclude: tuple[str, ...]) -> int:
    rx = re.compile(regex)
    n = 0
    for base in SCAN_ROOTS:
        for path in (root / base).rglob("*.py"):
            rel = path.relative_to(root).as_posix()
            if not _match(rel, include) or _match(rel, exclude):
                continue
            text = path.read_text(encoding="utf-8", errors="replace")
            n += sum(
                1
                for line in text.splitlines()
                if rx.search(line) and not line.lstrip().startswith("#")
            )
    return n


def main(root: Path, verbose: bool = False) -> list[str]:
    """Return one failure message per row whose count grew past max_count."""
    failures = []
    for name, regex, include, exclude, max_count, canonical in ROWS:
        n = count(root, regex, include, exclude)
        if verbose:
            print(f"{'FAIL' if n > max_count else 'ok  '} {n:>3}/{max_count:<3} {name}")
        if n > max_count:
            failures.append(
                f"{name}: {n} > {max_count}. new copy of {name} — use {canonical}; "
                "if you consolidated copies, lower max_count"
            )
        elif n < max_count:
            print(f"hint: lower max_count for {name} to {n}")
    return failures


if __name__ == "__main__":
    repo = Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent
    errors = main(repo, verbose=True)
    for e in errors:
        print(e, file=sys.stderr)
    sys.exit(1 if errors else 0)
