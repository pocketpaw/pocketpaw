#!/usr/bin/env python3
# Created 2026-10-01 (canonicalization Wave 0, CN-1): grep-count ratchet for
# function-level duplicates that import-linter can't see. Each row pins today's
# count; the check fails only when a count GROWS. Consolidating copies is
# welcome: lower max_count in the same PR. Stdlib only.
# 2026-10-02: counts lowered to the post-consolidation totals after the canonicalization PRs landed.
# Updated 2026-10-01: added the FabricJournalStore( construction row, which
# closes the `from pocketpaw.fabric import FabricJournalStore` re-export gap
# the Fabric import-linter contract can't see. Review pass: comment lines are
# skipped, rows for the audit-store and InstinctApproval re-export paths, hmac
# row excludes inbound verifiers, and a "lower max_count" hint when a count drops.
# Why: copies of a primitive drift apart (different floors, caps, SSRF checks),
# so new code must reuse the canonical one instead of adding another.
"""Fail on new copies of primitives we already have.

Usage: scripts/dup-ratchet [repo_root]   (exit 1 on growth)
"""

from __future__ import annotations

import re
import sys
from fnmatch import fnmatch
from pathlib import Path

# Only production code is scanned; root tests/ is excluded by construction.
SCAN_ROOTS = ("src", "ee/pocketpaw_ee")

# (name, regex, include globs, exclude globs, max_count, canonical)
# Globs match the repo-relative posix path. Counts are matching LINES.
ROWS: list[tuple[str, str, tuple[str, ...], tuple[str, ...], int, str]] = [
    (
        "raw UPDATE instinct_actions",
        r"UPDATE instinct_actions",
        ("*",),
        ("src/pocketpaw/instinct/store.py",),
        2,
        "InstinctStore.update_parameters / _update_status (src/pocketpaw/instinct/store.py)",
    ),
    (
        "daily try_spend counter",
        r"def try_spend",
        ("*",),
        (),
        2,
        "one try_spend(meter) in cloud/metering, caps via resolve_entitlements",
    ),
    (
        "env-read daily cap",
        r"[\"']POCKETPAW_\w*DAILY\w*[\"']",
        ("*",),
        (),
        6,
        "caps from entitlements.resolve_entitlements (0 = disabled, None = uncapped)",
    ),
    (
