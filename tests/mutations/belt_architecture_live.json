    "replace": "(\"failed\", False),",
    "tests": [
      "tests/cloud/test_belt_architecture_live.py"
    ]
  },
  {
    "label": "an in-flight run does not read changing",
    "file": "ee/pocketpaw_ee/cloud/belt/architecture_live.py",
    "find": "(\"changing\", bool(row[\"runs\"])),",
    "replace": "(\"changing\", False),",
    "tests": [
      "tests/cloud/test_belt_architecture_live.py"
    ]
  },
  {
    "label": "a trunk commit in the window does not read changed",
    "file": "ee/pocketpaw_ee/cloud/belt/architecture_live.py",
    "find": "(\"changed\", row[\"merges\"][\"count_7d\"] > 0),",
    "replace": "(\"changed\", False),",
    "tests": [
      "tests/cloud/test_belt_architecture_live.py"
    ]
  },
  {
    "label": "changed outranks changing",
    "file": "ee/pocketpaw_ee/cloud/belt/architecture_live.py",
    "find": "        (\"changing\", bool(row[\"runs\"])),\n        (\"changed\", row[\"merges\"][\"count_7d\"] > 0),",
    "replace": "        (\"changed\", row[\"merges\"][\"count_7d\"] > 0),\n        (\"changing\", bool(row[\"runs\"])),",
    "tests": [
      "tests/cloud/test_belt_architecture_live.py"
    ]
  },
  {
    "label": "an unfinished check rolls up green",
    "file": "ee/pocketpaw_ee/cloud/belt/architecture_live.py",
    "find": "for s in (\"red\", \"pending\", \"green\")",
    "replace": "for s in (\"red\", \"green\", \"pending\")",
    "tests": [
      "tests/cloud/test_belt_architecture_live.py"
    ]
  },
  {
