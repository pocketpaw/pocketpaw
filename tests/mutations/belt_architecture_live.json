    ]
  },
  {
    "label": "a signal with an unjoined file also lands on the repo row",
    "file": "ee/pocketpaw_ee/cloud/belt/architecture_live.py",
    "find": "return [rows[i] for i in ids] or [repo]",
    "replace": "return [rows[i] for i in ids] + ([repo] if None in {component_for(f, index) for f in files} else [])",
    "tests": [
