{
  "id": "load-order-inject",
  "asserts": "A plugin with unmet required deps stays PENDING; it activates only after the provider has fully settled, never mid-apply.",
  "semantics": "\u00a72",
  "plugins": {
    "a": {
      "provides": [
        "svcA"
      ]
    },
    "b": {
      "inject": {
        "required": [
          "svcA"
        ]
      }
    }
  },
  "steps": [
    {
      "op": "mount",
      "plugin": "b"
    },
    {
      "expect_state": {
        "b": "PENDING"
      }
    },
    {
      "op": "mount",
      "plugin": "a"
    },
    {
      "op": "settle"
    },
    {
      "expect_state": {
        "a": "ACTIVE",
        "b": "ACTIVE"
      }
    }
  ],
  "expect_trace": [
    "b:PENDING",
    "a:LOADING",
    "a:provide:svcA",
    "a:ACTIVE",
    "b:LOADING",
    "b:ACTIVE"
  ]
}
