{
  "id": "failed-apply-rolls-back",
  "asserts": "DRAGON (DeepSeek divergence #6). A throw in apply rolls back every effect already collected, in reverse order, and lands in FAILED holding no live effects.",
  "semantics": "\u00a73, \u00a74",
  "plugins": {
    "a": {
      "effects": [
        "e1",
        "e2"
      ],
      "apply_throws": true
    }
  },
  "steps": [
    {
      "op": "mount",
      "plugin": "a"
    },
    {
      "op": "settle"
    },
    {
      "expect_state": {
        "a": "FAILED"
      }
    }
  ],
  "expect_trace": [
    "a:LOADING",
    "a:effect:e1:setup",
    "a:effect:e2:setup",
    "a:apply:throw",
    "a:effect:e2:dispose",
    "a:effect:e1:dispose",
    "a:FAILED"
  ]
}
