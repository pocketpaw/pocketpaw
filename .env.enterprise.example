# ──────────────────────────────────────────────────────────────────────────
# PocketPaw Enterprise — sovereign per-tenant environment template.
# Created: 2026-06-10 (sov/w1a-deploy).
#
# Copy to .env (gitignored), fill in the few REQUIRED values, then:
#   docker compose -f docker-compose.enterprise.yml up -d --build
#
# Most secrets are handled FOR you:
#   * AUTH_SECRET  — auto-generated + persisted on first run by the image
#                    entrypoint. Only set it here to pin/rotate it yourself.
#   * ADMIN_PASSWORD — auto-generated by the app and printed ONCE to the logs
#                    (`docker compose logs app | grep -i password`). Only set it
#                    here to choose your own. The legacy "admin123" is rejected.
#   * CLOUD_MONGODB_URI / POCKETPAW_REDIS_URL — set by the compose file to the
#                    in-network service names; do NOT set them here.
# ──────────────────────────────────────────────────────────────────────────

# ── REQUIRED: LLM provider key ────────────────────────────────────────────
# At least one provider. Anthropic is the default agent backend.
POCKETPAW_ANTHROPIC_API_KEY=sk-ant-...
# POCKETPAW_OPENAI_API_KEY=sk-...

# ── REQUIRED for production: license key posture ──────────────────────────
# The image runs POCKETPAW_ENV=production. Under that posture the license layer
# REFUSES to verify against the committed DEV key (it is forgeable — its private
# seed ships in the repo). You MUST supply your own keypair:
#
#   1. Generate a keypair (run inside the app container after first `up`):
#        docker compose -f docker-compose.enterprise.yml \
#          exec app python -m pocketpaw_ee.cloud.mint generate-keypair
#      It prints PRIVATE (keep secret) and PUBLIC (set below) hex keys.
#
#   2. Set the PUBLIC key here:
POCKETPAW_LICENSE_PUBLIC_KEY=
#
#   3. Mint a license with the matching PRIVATE key and set it here:
#        docker compose -f docker-compose.enterprise.yml exec \
#          -e POCKETPAW_LICENSE_PRIVATE_KEY=<private-hex> app \
#          python -m pocketpaw_ee.cloud.mint mint --org acme --plan enterprise \
#          --seats 100 --days 365
POCKETPAW_LICENSE_KEY=

# ── OPTIONAL: pin your own secrets (otherwise auto-handled) ────────────────
# AUTH_SECRET — strong random; auto-generated + persisted if left unset.
#   Generate one yourself with:
#     python -c 'import secrets; print(secrets.token_urlsafe(48))'
# AUTH_SECRET=
# ADMIN_EMAIL=admin@your-org.com
# ADMIN_NAME=Admin
# ADMIN_PASSWORD=            # leave unset to auto-generate (printed to logs once)

# ── OPTIONAL: TLS / reverse-proxy posture ─────────────────────────────────
# Set true when serving over HTTPS behind a reverse proxy (also counts as a
# production signal). Leave unset for plain-HTTP local testing.
# POCKETPAW_AUTH_COOKIE_SECURE=true

# ── OPTIONAL: agent backend + tools ───────────────────────────────────────
# POCKETPAW_AGENT_BACKEND=claude_agent_sdk
# POCKETPAW_TOOL_PROFILE=coding

# ── Paw Sites — publish toolchain (baked into the image; override only to tune) ─
# A live Paw Site publish shells out to the bundled paw-sites generator + bun and
# installs @ripple-ui/svelte. The image already bakes sensible defaults — these are
# here for visibility / override, NOT required for a publish to work.
#   PAW_SITES_GEN_CMD     — the generator invocation. UNSET by default: the
#                           `paw-sites-gen` wrapper is on PATH. Set only to point at
#                           an alternate build, e.g. "node /path/cli.js".
# PAW_SITES_GEN_CMD=
#   PAW_SITES_RIPPLE_DEP  — the npm source the generated site's @ripple-ui/svelte
#                           dep is rewritten to before install. Baked to the bundled
#                           tarball; override to pin a published registry version
#                           once ripple is public.
# PAW_SITES_RIPPLE_DEP=file:/opt/ripple-ui-svelte-0.5.0.tgz
#   PAW_SITES_MOTION_DEP  — motion.dev version the generated site declares (ripple
#                           lazy-loads it). Keep in lockstep with ripple's pin.
# PAW_SITES_MOTION_DEP=^12.40.0
#
# Build-time source switch (NOT runtime env — pass as docker --build-arg; see
# deploy/README-build.md). Internal CI / Coolify clones the private sibling repos:
#   PAW_SITES_SOURCE=clone   RIPPLE_SOURCE=clone
#   PAW_SITES_REPO=https://github.com/qbtrix/paw-sites.git   PAW_SITES_REF=main
#   RIPPLE_REPO=https://github.com/qbtrix/ripple-iui.git     RIPPLE_REF=main

# ── Paw Sites — Cloudflare deploy (REQUIRED only for a LIVE edge deploy) ───────
# A publish takes the REAL Cloudflare Workers-for-Platforms path when ALL of these
# are set; otherwise it DEGRADES to a local static-serve (dev only — the site is
# served from the container at a localhost URL, not the edge). Leave unset for a
# dev / smoke deploy; set the group to ship sites live to Cloudflare.
# PAW_CF_ACCOUNT_ID=
# PAW_CF_API_TOKEN=
# PAW_CF_ZONE_ID=
# PAW_CF_DISPATCH_NAMESPACE=paw-sites
